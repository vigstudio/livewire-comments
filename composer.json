{
    "name": "vigstudio/livewire-comments",
    "description": "Livewire 4 comments UI backed by vgcomments",
    "keywords": [
        "vigstudio",
        "livewire-comments",
        "laravel-comments",
        "comments",
        "comments-system",
        "livewire"
    ],
    "homepage": "https://github.com/vigstudio/livewire-comments",
    "license": "MIT",
    "type": "laravel-library",
    "version": "2.0.0",
    "authors": [
        {
            "name": "Nghiane.com",
            "email": "vingamagic@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "vigstudio/vgcomments": "^2.0",
        "livewire/livewire": "^4.0",
        "archielite/laravel-heroicons": "^0.2.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Vigstudio\\LivewireComments\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vigstudio\\LivewireComments\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vigstudio\\LivewireComments\\LivewireCommentsServiceProvider"
            ],
            "aliases": {}
        }
    }
}
